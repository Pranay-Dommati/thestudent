# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# IMPORTANT: 
# 1. Generate a new SECRET_KEY for production
# 2. Set DEBUG=False
# 3. Configure all required API keys
# 4. Set proper domain names
# =============================================================================

# Django Core Settings
DEBUG=False
SECRET_KEY=your-super-secret-production-key-here-64-chars-minimum

# Security Settings
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Cookie Settings (for cross-domain)
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

# Database Configuration
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studentshub_production
DB_USER=studentshub_user
DB_PASSWORD=your-strong-database-password
DB_SSL_REQUIRE=true
DB_CONN_MAX_AGE=60

# JWT Settings
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Upload Limits
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
MAX_THUMBNAIL_SIZE=5242880

# API Keys (REQUIRED)
YOUTUBE_API_KEY=your-youtube-api-key
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id

# Google OAuth2 (REQUIRED for social auth)
GOOGLE_OAUTH2_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-oauth-client-secret

# Rate Limiting
MAX_TOPICS_PER_DAY=16
MAX_TOPICS_PER_REQUEST=4

# Logging
DJANGO_LOG_LEVEL=WARNING
LOG_LEVEL=INFO

# Redis (for production caching)
REDIS_URL=redis://localhost:6379/1

# Email Settings - AWS SES (Mumbai Region)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=AKIAWEBLRWIXBWW2J65X
EMAIL_HOST_PASSWORD=BAJqr+MIuFWHTTxocuq4DW9d3M8EeGqS+ftMwUNv52zV
DEFAULT_FROM_EMAIL=info@easylearnova.com

# -----------------------------------------------------------------------------
# Cloudinary Media Storage (Production)
# -----------------------------------------------------------------------------
# Strongly recommended for production to avoid ephemeral media loss.
# Choose ONE method to provide credentials.

# Method A: Single URL (recommended)
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@dakmlg4ui

# Method B: Individual variables
# CLOUDINARY_CLOUD_NAME=dakmlg4ui
# CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
# CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>

# Always set this to true in production when using Cloudinary
USE_CLOUDINARY=true

# Keep uploads organized under this folder/prefix in your Cloudinary account
CLOUDINARY_MEDIA_PREFIX=easylearnova

# Optional default placeholder if an image is missing
# DEFAULT_THUMBNAIL_PLACEHOLDER=https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=800&auto=format&fit=crop