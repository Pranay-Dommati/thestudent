# Local Development Environment Variables
# This file is used when running `npm run dev`

# Point to local Django backend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_AI_BASE_URL=http://127.0.0.1:8000/ai

# API Timeout Configuration (in milliseconds)
# Increased to 120 seconds (120000ms) for course content loading
VITE_API_TIMEOUT_MS=120000

# Google OAuth Client ID (same as production)
VITE_GOOGLE_CLIENT_ID=144742361946-79uh0mjrfnsr8tdbmk8t8mof6b7ih38a.apps.googleusercontent.com
