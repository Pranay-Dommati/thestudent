# =============================================================================
# frontend — Environment Variables Template
# =============================================================================
# Copy this file to .env for local dev, or .env.production for production.
# NEVER commit .env or .env.production — they are gitignored.
# =============================================================================

# Backend API URL
# Local dev:
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Production: https://easylearnova-backend.onrender.com/api

# AI Services URL
VITE_AI_BASE_URL=http://127.0.0.1:8000/ai
# Production: https://easylearnova-backend.onrender.com/ai

# Code Visualizer Backend
VITE_CODE_VISUALIZER_API_URL=http://localhost:5000/api
VITE_CODE_VISUALIZER_ROOT_URL=http://localhost:5000
# Production: https://code-visualizer-api-ucco.onrender.com/api

# API Timeout (ms)
VITE_API_TIMEOUT_MS=120000

# Google OAuth2 Client ID
VITE_GOOGLE_CLIENT_ID=your-google-oauth2-client-id

# PostHog Analytics (optional)
# VITE_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_APP_URL=https://us.posthog.com
# VITE_POSTHOG_AUTOCAPTURE=true
# VITE_POSTHOG_DISABLE_SESSION_RECORDING=false
# VITE_POSTHOG_PERSISTENCE=localStorage

# Base path (for subpath deployments)
VITE_BASE_PATH=/
