# Django
DEBUG=False
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=easylearnova.com,www.easylearnova.com

# CORS and CSRF (comma-separated, include scheme)
CORS_ALLOWED_ORIGINS=https://easylearnova.com,https://www.easylearnova.com
CSRF_TRUSTED_ORIGINS=https://easylearnova.com,https://www.easylearnova.com
FRONTEND_ORIGINS=https://easylearnova.com,https://www.easylearnova.com

# Static files (WhiteNoise)
WHITENOISE_MAX_AGE=31536000

# Database (Hostinger MySQL)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u787111463_easylearnovadb
DB_USER=your_hostinger_db_username
DB_PASSWORD=your_hostinger_db_password
DB_SSL_REQUIRE=false
DB_CONN_MAX_AGE=60

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# API keys
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Scrib AI and storage
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=easylearnova-scrib
AWS_S3_REGION_NAME=ap-south-1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google OAuth2
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
SOCIAL_AUTH_LOGIN_REDIRECT_URL=https://www.easylearnova.com/
SOCIAL_AUTH_LOGIN_URL=/auth/login/

# Frontend base URL used by emails and default OAuth redirect in production
FRONTEND_DOMAIN=https://www.easylearnova.com

# Rate limiting
MAX_TOPICS_PER_MONTH=15
MAX_TOPICS_PER_REQUEST=4
ENFORCE_DAILY_LIMIT=false
TOPIC_RATE_LIMIT_BYPASS_DEV=false

# Cookies
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
X_FRAME_OPTIONS=SAMEORIGIN
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Logging
DJANGO_LOG_LEVEL=INFO
