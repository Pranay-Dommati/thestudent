# =============================================================================
# EasyLearnova Backend — .gitignore
# =============================================================================

# -------------------------
# Environment / Secrets — NEVER commit
# -------------------------
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
*.env

# Google Service Account JSON keys
easylearnova-*.json
*-key.json
*gcp*.json
*vertex*.json


# -------------------------
# Python cache directories
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
authentication/__pycache__/
authentication/migrations/__pycache__/
backend/__pycache__/
chatbotcourse/__pycache__/
chatbotcourse/migrations/__pycache__/
courses/__pycache__/
courses/migrations/__pycache__/

# -------------------------
# Django specific
# -------------------------
*.log
db.sqlite3
local_settings.py
staticfiles/
media/
tables_list.txt

# -------------------------
# Database backups
# -------------------------
*.dump
*.sql
sqlite_backup/
sqlite_backup.json
fixtures_export/

# -------------------------
# Python virtual environments
# -------------------------
venv/
.venv/
env/
