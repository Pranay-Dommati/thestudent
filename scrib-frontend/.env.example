# =============================================================================
# scrib-frontend — Environment Variables Template
# =============================================================================
# Copy this file to .env for local dev, or .env.production for production.
# NEVER commit .env or .env.production — they are gitignored.
# =============================================================================

# Backend API URL
# Local dev:
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Production: https://easylearnova-backend.onrender.com/api

# Google OAuth2 Client ID
VITE_GOOGLE_CLIENT_ID=your-google-oauth2-client-id

# Gemini API Key (client-side, if used directly from frontend)
# VITE_GEMINI_API_KEY=your-gemini-api-key
