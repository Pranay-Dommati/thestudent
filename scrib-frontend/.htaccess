RewriteEngine On

# Redirect non-www to www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

# Do not rewrite requests to static asset folders
RewriteCond %{REQUEST_URI} ^/(assets|images|media|fonts|favicon\.ico) [NC]
RewriteRule ^ - [L]

# If a directory or a file exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise forward to the root index.html for client-side routing
RewriteRule ^(.*)$ /index.html [L,QSA]

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-XSS-Protection "1; mode=block"
Header always set X-Frame-Options "SAMEORIGIN"

# Cache static assets aggressively (1 year)
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|map)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
  # Content-Types hints (usually set by server automatically)
  <IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
    AddType application/json .map
  </IfModule>
</FilesMatch>

# But ensure HTML is always fresh
<FilesMatch "\.html$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "0"
</FilesMatch>
