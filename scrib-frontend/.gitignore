# Environment / Secrets — NEVER commit
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
*.env

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
