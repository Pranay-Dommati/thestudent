# =============================================================================
# EasyLearnova — Root .gitignore
# =============================================================================

# -------------------------
# Environment / Secrets — NEVER commit these
# -------------------------
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
*.env

# Google Service Account JSON keys
easylearnova-*.json
*-key.json
*gcp*.json
*vertex*.json

backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production
scrib-frontend/.env
scrib-frontend/.env.local
scrib-frontend/.env.development
scrib-frontend/.env.production
codevisualizer-frontend/.env
codevisualizer-frontend/.env.local
codevisualizer-frontend/.env.development
codevisualizer-frontend/.env.production
company-frontend/.env
company-frontend/.env.local
company-frontend/.env.development
company-frontend/.env.production
courses-frontend/.env
courses-frontend/.env.local
courses-frontend/.env.development
courses-frontend/.env.production

# -------------------------
# Database dumps & backups — contain user data / credentials
# -------------------------
*.dump
*.sql
*.sqlite3
db_backup.*
db.sqlite3
*_backup.json
*_backup.js
local_data_backup*.json
courses_backup.json
users_backup.json
sqlite_backup.json
backend/sqlite_backup/
backend/fixtures_export/

# -------------------------
# Log files
# -------------------------
*.log
django.log
backend/django.log
backend/tables_list.txt

# -------------------------
# Cookies / session files
# -------------------------
cookies.txt

# -------------------------
# Temporary / scratch files
# -------------------------
*.backup
CourseDetails.jsx.backup
topicclassifier_backup.js
test-output.html

# -------------------------
# Python virtual environments
# -------------------------
venv/
.venv/
env/
venv
.venv/Lib

# -------------------------
# Python compiled files & cache
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.class

# -------------------------
# Django specific
# -------------------------
local_settings.py
backend/staticfiles/
backend/media/

# -------------------------
# Distribution / packaging
# -------------------------
dist/
build/
*.egg-info/

# -------------------------
# Node.js
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------
# IDE settings
# -------------------------
.idea/
.vscode/

# -------------------------
# Operating System files
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Windows reserved filenames
# -------------------------
NUL
CON
PRN
AUX