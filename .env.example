# =============================================================================
# EasyLearnova — Root Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.
# =============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-generate-with-django-get_random_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1,easylearnova-backend.onrender.com,easylearnova.com,www.easylearnova.com

# Database (Hostinger MySQL)
DB_ENGINE=mysql
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SSL_REQUIRE=false
DB_CONN_MAX_AGE=60

# CORS and CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Domain
FRONTEND_DOMAIN=http://localhost:5173

# Static files (WhiteNoise)
WHITENOISE_MAX_AGE=31536000

# JWT Settings
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# OpenAI (Scrib AI feature)
OPENAI_API_KEY=your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-2

# AWS S3 (Scrib image storage)
SCRIB_S3_ACCESS_KEY_ID=your-aws-iam-access-key-id
SCRIB_S3_SECRET_ACCESS_KEY=your-aws-iam-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=ap-south-1

# API Keys
YOUTUBE_API_KEY=your-youtube-api-key
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-google-cse-id

# Google OAuth2
GOOGLE_OAUTH2_CLIENT_ID=your-google-oauth2-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-oauth2-client-secret
SOCIAL_AUTH_LOGIN_REDIRECT_URL=http://localhost:5173/
SOCIAL_AUTH_LOGIN_URL=/auth/login/

# AWS SES (Email sending via boto3 API — works on Render free tier)
SES_AWS_ACCESS_KEY_ID=your-ses-iam-access-key-id
SES_AWS_SECRET_ACCESS_KEY=your-ses-iam-secret-access-key
AWS_REGION=ap-south-1
DEFAULT_FROM_EMAIL=info@yourdomain.com

# Razorpay Payments
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# SMTP Settings (Legacy — prefer SES API above)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-iam-username
SMTP_PASSWORD=your-smtp-iam-password
SMTP_USE_SSL=false
SMTP_USE_TLS=true

# Rate Limiting
MAX_TOPICS_PER_MONTH=15
MAX_TOPICS_PER_REQUEST=4
ENFORCE_DAILY_LIMIT=false
TOPIC_RATE_LIMIT_BYPASS_DEV=false

# Security Headers
X_FRAME_OPTIONS=SAMEORIGIN
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Logging
DJANGO_LOG_LEVEL=INFO

# Cloudinary (Optional — for media storage)
# USE_CLOUDINARY=true
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# CLOUDINARY_MEDIA_PREFIX=easylearnova
